# ── مطلوب ──
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
OWNER_CHAT_ID=PUT_OWNER_CHAT_ID_HERE

# ── بنك الإجابات (ملف الأتمتة) — افتراضيًا answers.txt بجوار bot.py ──
ANSWERS_FILE=answers.txt   # يقبل بنك .txt أو Markdown منسقًا بصيغتي السؤال/الإجابة

# ── الأداء والتشغيل (القيم الحالية هي الافتراضية) ──
MAX_JOBS=2              # عدد الحسابات المتزامنة (API خفيف، مفيش متصفح)
MAX_QUEUE=10
JOB_TIMEOUT_MIN=240
SUBJECT_ID=7
ANSWER_DELAY=0          # ثانية بين الإجابات (0 = أسرع)
TEST_PARALLEL=6         # أقصى توازي لحفظ إجابات الاختبار (تكيّفي: بينزل لوحده لو المنصة ضغطت 429/5xx)
LESSON_PARALLEL=6       # أقصى توازي لأسئلة الدرس (تكيّفي). غيّره لـ 1 لو عايز تقفل التوازي
MAX_ITEM_ATTEMPTS=3     # محاولات النشاط قبل تخطيه
MAX_TEST_ATTEMPTS=4     # إعادة الاختبار الفاشل بالإجابات المتعلَّمة
UNMATCHED_POLICY=guess  # guess = يخمّن ويتعلم من المنصة | stop = يوقف عند سؤال مش في البنك
LEARNED_FILE=           # افتراضي: learned_answers.json بجوار DB_PATH

# ── اختياري ──
DEV_USERNAME=@A7med19_7
DB_PATH=bot.db          # على Railway: /data/bot.db (بيتظبط تلقائيًا في الـ Dockerfile)
PLATFORM_PROXY=         # لو المنصة بترفض IP Railway (403): http://user:pass@host:port

# ── متغيرات المحرّك الجديدة ──
# LESSON_RETRY_WRONG=1   لو إجابة درس طلعت غلط والمنصة ما كشفتش الصح: يجرّب باقي الخيارات بالاستبعاد
#                        (بدونها الدرس بيتعلّق والمنهج كله اللي بعده بيفضل مقفول). 0 = يقفلها.
# IDLE_POLLS=3           لو المنهج ناقص بس مفيش نشاط مفتوح: يعيد الجلب كام مرة قبل ما يعتبره مقفول فعلاً
# HTTP_RETRIES=4         إعادة محاولة الطلبات عند 429/5xx/انقطاع
# MAX_JOBS               المحرّك HTTP خفيف (≈10MB للجلسة)، فينفع ترفعها (3–5) — راقب لو المنصة بدأت تحظر الـ IP (PLATFORM_PROXY)
# DB_PATH=/data/bot.db   على Railway: Volume على /data — learned_answers.json بيتحفظ جنبها ولازم يفضل بعد كل deploy
PARALLEL_START=3        # نقطة بداية التوازي التكيّفي (بيزيد لحد الأقصى ويقل لو المنصة ضغطت)
PRIORITY_JOBS=10        # عدد حسابات المشتركين (كود مشترى/VIP/غير محدود) اللي بتتحل فورًا في نفس الوقت
PRICE_SINGLE=50         # سعر المحاولة الواحدة (جنيه) في رسالة الاشتراكات
PRICE_PACK10=120        # سعر ١٠ محاولات
PRICE_WEEKLY=250        # سعر الغير محدود أسبوع

# ── v6.8: تسريع ──
# BG_ACHIEVEMENTS=1       طلب الإنجازات الاختياري في الخلفية (0 = الطريقة القديمة المتتابعة)
# QUREO_TALK_PARALLEL=1   حفظ إجابات درس Qureo الواحد بالتوازي (1 = متتابع). جرّب 3 على حساب واحد الأول؛ لو فشل أي حفظ بيتعاد متتابعًا
# SUB_CACHE_SECONDS=300   مدة تذكّر اشتراك المستخدم في القنوات بالثواني (0 = اسأل تيليجرام في كل مرة)
# SUBJECT_IDS=           اختياري: مواد إضافية تتجرّب بعد SUBJECT_ID. مش لازم لطلاب اللغات؛ البوت بيكتشف مواد الحساب لوحده (GET /subjects)
QUREO_PERFECT_PASS=1    # بعد حل كوريو (بايثون/جافاسكريبت) يتأكد إن كل مراجعة/اختبار 100% ويعيد الناقص. 0 = إيقاف
